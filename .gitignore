# =========================================================================
# OmniFace AI - Production Android & Biometric ML .gitignore
# =========================================================================

# Built application files
*.apk
*.aab
*.ap_
*.dex
*.jks
*.keystore

# Gradle build directories & caches
.gradle/
build/
app/build/
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar

# Android Studio & IDE files
.idea/
.idea/*
*.iml
local.properties
.DS_Store
Captures/
*.hprof
*.ipr
*.iws

# Workspace / Scratch / Tooling caches
.scratch/
scratch/
.wrangler/
.cursor/
.vscode/
aapt2

# Python ML & Training caches
__pycache__/
*.pyc
*.pyo
models_cache/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
dist/
*.log

# Kaggle execution temp workspaces & large downloaded bundles
kaggle_output/
training/kaggle_debug*/
training/kaggle_unified_output/
training/*.zip
training/*.tar.gz

# Large Raw Keras Checkpoints & Heavy Model Binaries (>25MB / raw checkpoints)
models/*.keras
models/*.zip
models/qualcomm_suite/
models/qualcomm_cavaface/
models/antelopev2/
models/buffalo_l/
models/latest_pretrained/

# Temporary & machine-specific build scripts
*.tmp
*.bak
*~
.directory
.github/
Omniface-AI.zip
Omniface-AI/
"omniface-ai (1)/"
"omniface-ai (1).zip"
.agents/
metadata.json

# Local ARM64 / Cross-Arch bootstrap scripts & keystores
setup_armdroid64.sh
build_local.sh
debug.keystore
debug.keystore.*
local.properties

# Release signing credentials (never commit)
keystore.properties

# Temporary test captures & test data
*.png
test_faces/
download_and_verify_faces.py
run_end_to_end_real_face_test.py

