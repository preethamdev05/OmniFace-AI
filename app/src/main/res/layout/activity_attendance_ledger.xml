<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_back_ledger"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forensic Ledger"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_total_records"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Verified Records: 0"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_share_csv"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn_slate_modern"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="↗ Share"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_export_csv"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_cyan_modern"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="📁 Export"
            android:textColor="@color/bg_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Search Input Bar -->
    <EditText
        android:id="@+id/et_search_ledger"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input_modern"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:drawableTint="@color/text_muted"
        android:hint="Search by student name or roll..."
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

    <!-- Filter Buttons Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_cyan_modern"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="All Records"
                android:textColor="@color/bg_dark"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_filter_today"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_slate_modern"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="Today"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_filter_synced"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_slate_modern"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="Synced ☁"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_filter_unsynced"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_btn_slate_modern"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="Local Vault 🔒"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Records Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_attendance_ledger"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp" />

</LinearLayout>


